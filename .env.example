HOST=127.0.0.1
PORT=8600
APP_ENV=development
SITE_URL=http://127.0.0.1:8600
DATA_DIR=./data
# OpenAI-compatible Chat Completions endpoint. Use your provider's supported model.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
DAILY_CALL_LIMIT=30
VISITOR_DAILY_LIMIT=5
# Production uses a restricted local socket helper for existing Waywise SMTP and email identity links.
ACCOUNT_BRIDGE=0
